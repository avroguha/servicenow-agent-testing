# =====================================================================================================================
#  acctest - ServiceNow Agent Client Collector (ACC) release qualification
#  Copy this file to `.env` and fill it in. `.env` is git-ignored: it holds credentials and server names and must
#  never be committed. Every value can also be given as a real environment variable, which overrides the file.
#
#  Quick start
#    python acctest.py preflight            # checks instance, ACC app, MID server, API key, targets
#    python acctest.py versions             # which agent versions / OS packages the instance offers
#    python acctest.py run                  # full qualification of AGENT_VERSION -> results/<version>/result.html
#  Home lab only:
#    python acctest.py lab provision        # create test containers on Proxmox and write targets.yml
# =====================================================================================================================


# ---------------------------------------------------------------------------------------------------------------------
# 1. ServiceNow instance
# ---------------------------------------------------------------------------------------------------------------------
# Full URL of the instance, no trailing slash. At the company this is the instance the agents report to (the one that
# owns the MID server below) - usually a sub-production instance.
SN_INSTANCE=https://devNNNNNN.service-now.com

# A user with at least: sn_agent.admin (ACC admin), mid_server (read MID records), itil / cmdb read, and
# `rest_api_explorer` is NOT needed. To create the MID WebSocket extension or API key automatically the user needs
# admin. Basic auth is used for REST; the same account is used for the headless browser login (UI-only checks).
SN_USER=admin
SN_PASS=change-me

# Set to false only when the instance presents a private / self-signed certificate (never for a real instance).
SN_VERIFY_TLS=true

# Can SN_USER log in through the normal login form (user name + password)? Set false when the instance is behind
# SSO with no local login: UI-only verifications are then skipped and marked "skipped - needs UI".
SN_UI_LOGIN=true

# REST timeout in seconds. Personal developer instances are slow - leave 120 unless calls time out.
SN_TIMEOUT_S=120


# ---------------------------------------------------------------------------------------------------------------------
# 2. MID Server the agents connect through
#    Agents never talk to the instance directly: they open a WebSocket to the MID Server's "MID WebSocket Server"
#    extension (default port 8800). The MID must be Up and Validated on the instance.
# ---------------------------------------------------------------------------------------------------------------------
# Name of the MID Server record (ecc_agent.name) - exactly as shown in MID Server > Servers.
MID_SERVER_NAME=my-mid-server

# Host name or IP the *agents* use to reach the MID. It must resolve/route from every target server (not from this
# machine). Use the name the MID's certificate was issued for when the MID uses a CA-signed certificate.
MID_HOST=mid01.example.internal

# WebSocket port of the extension (ServiceNow default 8800).
MID_WS_PORT=8800

# true  -> if no "MID WebSocket Server" extension exists for MID_SERVER_NAME, create and start one (needs admin).
# false -> only verify it exists and is started; fail the pre-flight otherwise (use this at the company).
MID_AUTO_CONFIGURE=false
# Name given to an extension created automatically (ignored when one already exists).
MID_WS_EXTENSION_NAME=ACC WebSocket Server


# ---------------------------------------------------------------------------------------------------------------------
# 3. ACC API key
#    Every agent authenticates to the MID with an API key from Agent Client Collector > Configuration > API Keys
#    (table sn_agent_api_key). The MID validates it against the instance.
# ---------------------------------------------------------------------------------------------------------------------
# Paste the key value here (company: the key the ACC admin shares with you). Leave empty at home and let the tool
# create one (ACC_API_KEY_AUTO_CREATE=true); the generated key is written back into this file.
ACC_API_KEY=

# Name of the API key record to create or reuse when ACC_API_KEY is empty.
ACC_API_KEY_NAME=acc-agent-testing
ACC_API_KEY_AUTO_CREATE=false


# ---------------------------------------------------------------------------------------------------------------------
# 4. Agent versions and packages
# ---------------------------------------------------------------------------------------------------------------------
# Which agent version to qualify:
#   latest       -> the newest version the instance offers (Agent Client Collector > Deployment > Install Agent)
#   3.11.0       -> that exact version (must be offered by the instance)
#   all          -> every version the instance offers, one result.html each
AGENT_VERSION=latest

# Where the agent packages are stored: <dir>/<version>/<os>/<file> plus a manifest.json with SHA-256 sums.
AGENT_DOWNLOAD_DIR=dist
# false -> do not download; use what is already in AGENT_DOWNLOAD_DIR (air-gapped reruns).
AGENT_DOWNLOAD=true
# How the agent is installed on Linux targets:
#   package -> push the deb/rpm from AGENT_DOWNLOAD_DIR and configure it locally (targets need no internet)
#   script  -> run the instance's own install script on the target (it downloads from install.service-now.com)
AGENT_INSTALL_MODE=package


# ---------------------------------------------------------------------------------------------------------------------
# 5. Target servers (where the agent gets installed)
#    Listed in TARGETS_FILE (see targets.example.yml). Each entry says the OS, how to reach it (ssh / winrm / pct) and
#    which credentials to use. `python acctest.py versions` tells you which OS types the agent is available for -
#    provide one server per OS type you want qualified.
# ---------------------------------------------------------------------------------------------------------------------
TARGETS_FILE=targets.yml

# Defaults for targets that do not set their own. SSH key for Linux targets (passwords are not supported over SSH -
# install a key). The user must be root or have passwordless sudo.
TARGET_SSH_KEY=~/.ssh/id_ed25519
TARGET_SSH_USER=root
# Extra ssh options, e.g. a jump host: -J bastion.example.internal
TARGET_SSH_OPTIONS=
# Restrict a run to some targets by name or os key (comma separated); empty = all targets in the file.
TARGET_OS_FILTER=


# ---------------------------------------------------------------------------------------------------------------------
# 6. Home lab (Proxmox) - automatic target provisioning. Ignored when LAB_MODE=none (company).
# ---------------------------------------------------------------------------------------------------------------------
# proxmox -> `lab provision` creates one LXC container per LAB_OS_LIST entry and writes TARGETS_FILE
# none    -> you provide the servers yourself in TARGETS_FILE
LAB_MODE=none
PVE_HOST=192.168.0.10
PVE_USER=root
PVE_SSH_KEY=~/.ssh/id_ed25519
# First container id; containers use LAB_VMID_BASE, +1, +2 ... in LAB_OS_LIST order.
LAB_VMID_BASE=9520
# OS keys, each must have a template on the node: ubuntu2404 ubuntu2204 debian12 rocky9 rocky10 suse156 alpine
LAB_OS_LIST=ubuntu2404,rocky9
LAB_CT_MEMORY_MB=1024
LAB_CT_CORES=2
LAB_CT_DISK_GB=8
LAB_BRIDGE=vmbr0
LAB_STORAGE=local-lvm
# Nameservers written into the containers (the node's own resolv.conf is often not reachable from a container).
LAB_NAMESERVERS=192.168.0.1 1.1.1.1
# Host name prefix for the containers (acc-ubuntu2404, ...).
LAB_HOSTNAME_PREFIX=acc
# true -> destroy the containers at the end of a successful run.
LAB_DESTROY_AFTER=false


# ---------------------------------------------------------------------------------------------------------------------
# 7. Test tuning
# ---------------------------------------------------------------------------------------------------------------------
# Seconds to wait for a freshly installed agent to show Up on the instance.
AGENT_UP_TIMEOUT_S=600
# Seconds to wait for the agent's discovery (ACC-V) to create / update the server CI.
DISCOVERY_TIMEOUT_S=900
# Seconds to wait for one ad-hoc check run to return.
CHECK_TIMEOUT_S=300
# Only run checks whose name contains one of these (comma separated); empty = every applicable check.
CHECK_FILTER=
# Include the out-of-box checks and the custom (non-ServiceNow) check definitions / policies.
INCLUDE_OOB_CHECKS=true
INCLUDE_CUSTOM_CHECKS=true
# Also verify every active policy that applies to the target gets its checks scheduled and reporting.
RUN_POLICIES=true
# Resource test: sample the agent's CPU on the target for this many seconds after discovery and compare with the
# throttle configured in acc.yml; fail when average CPU exceeds the configured limit by more than the tolerance.
CPU_SAMPLE_SECONDS=60
CPU_TOLERANCE_PCT=5
# Seconds to give the agent to clean up temporary files and child processes after the last check.
CLEANUP_GRACE_S=120
# Performance metrics (Linux targets): a sampler on the host records, every PERF_STEP_S seconds while the agent works
# (discovery, checks, policies) and while it idles, the agent process tree's CPU, RSS, threads, fds, processes and disk
# I/O plus the host's CPU busy %, load and memory. The report shows them per phase; the test row turns WARN (never
# FAIL - the budget is yours) when the agent's average CPU while working, its RSS peak, or the host CPU busy increase
# (working minus idle) exceed these values.
PERF_SAMPLING=true
PERF_STEP_S=5
PERF_CPU_AVG_WARN_PCT=25
PERF_RSS_PEAK_WARN_MB=400
PERF_HOST_IMPACT_WARN_PCT=10
# true -> uninstall the agent from every target at the end (and verify the uninstall left nothing behind).
UNINSTALL_AFTER=false
# true -> abort the whole run when an install fails on any target; false -> record the failure and go on.
STOP_ON_INSTALL_FAILURE=false


# ---------------------------------------------------------------------------------------------------------------------
# 8. Reporting and headless browser
# ---------------------------------------------------------------------------------------------------------------------
RESULTS_DIR=results
REPORT_TITLE=ACC agent qualification
# The headless browser (Playwright/Chromium) is used for UI-only verifications and screenshots. Disable if it cannot
# be installed (results then say "needs UI" for those checks).
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_SCREENSHOTS=true


# ---------------------------------------------------------------------------------------------------------------------
# 8. Custom plugins and their signatures (fixtures: the script-deploying custom check)
# ---------------------------------------------------------------------------------------------------------------------
# ACC 7.x agents verify every plugin archive they fetch (acc.yml verify-plugin-signature, default true). A custom plugin
# - including a customer's own scripts - is REJECTED unless its archive carries a signature made with a certificate
# the agent can validate: the certificate reaches the agent as a zip the MID serves from
# <MID home>/agent/static/cert/customer/, and it must chain to a root the HOST trusts (the OS trust store: an internal
# CA at the company). The fixtures sign the acctest plugin with these; empty = a lab PKI is generated under .state/signing
# (root CA + code-signing certificate) - then TRUST_SIGNING_CERT_ON_TARGETS installs the lab root on the targets.
# Company: PLUGIN_SIGNING_KEY/CERT = a code-signing certificate issued by the internal CA; leave PLUGIN_SIGNING_CA and
# TRUST_SIGNING_CERT_ON_TARGETS empty/false (the hosts trust that CA already).
PLUGIN_SIGNING_KEY=
PLUGIN_SIGNING_CERT=
PLUGIN_SIGNING_CA=
TRUST_SIGNING_CERT_ON_TARGETS=false
# Where `fixtures create` copies the certificate zip: user@host (TARGET_SSH_KEY) or pct:<vmid> for a Proxmox container;
# empty = it tells you the file and the directory and you copy it by hand.
MID_SSH_TARGET=
MID_HOME=
# Do NOT turn plugin signature verification off to make custom plugins run ("false" writes verify-plugin-signature: false
# into acc.yml at install). Left empty the agent default (true) stays.
AGENT_VERIFY_PLUGIN_SIGNATURE=
